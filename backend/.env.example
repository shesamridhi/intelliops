DATABASE_URL=postgresql://intelliops:intelliops@localhost:5432/intelliops
REDIS_URL=redis://localhost:6379/0
JWT_SECRET_KEY=CHANGE_ME_IN_PRODUCTION_USE_ENV_VAR
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Set to "openai" or "anthropic" to use a real LLM for the agent; leave as
# "fallback" to use the deterministic rule-based agent (no key needed).
LLM_PROVIDER=fallback
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

GRPC_NOTIFICATION_HOST=localhost
GRPC_NOTIFICATION_PORT=50051
